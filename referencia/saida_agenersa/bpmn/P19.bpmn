      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Analisar contribuições e consolidar minuta&#10;[45% de 11 casos · espera 1 du · 0,4 h]">
      <bpmn:documentation>freq: 45% de 11; du: 1; horas: 0,4 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>

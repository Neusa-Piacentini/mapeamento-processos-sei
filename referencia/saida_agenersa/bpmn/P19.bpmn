      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t9" name="Emitir parecer jurídico sobre a matéria&#10;[64% de 11 casos · espera 0 du · 4 h]">
      <bpmn:documentation>freq: 64% de 11; du: 0; horas: 4 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>

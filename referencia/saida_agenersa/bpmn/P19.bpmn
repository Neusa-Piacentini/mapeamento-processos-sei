<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P19" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P19">
    <bpmn:participant id="Part_P19" name="P19 — Regulação do mercado livre de gás (CUSD e migração) (AS-IS · 11 casos · procedimento)" processRef="Processo_P19" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P19" isExecutable="false">
    <bpmn:documentation>Da deliberação, requerimento ou contrato autuado à deliberação do Conselho-Diretor, embargos e publicação Fontes: Casos SEI-480002/000528/2023 (CUSD do mercado livre: consulta pública, deliberação e embargos), SEI-220007/002145/2020 (TUSD e TUSD-E: consulta e audiência pública), SEI-220007/002146/2023 e SEI-480002/002996/2024; trilhas dos 11 processos do código (todos com trilha nativa), em especial SEI-480002/003694/2024 (CUSD-Termo) e SEI-220007/003478/2023 (enquadramento de consumidor livre). Evidências em saida/bpmn/evidencias_P19.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P19">
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ASSINF" name="Assessoria de Informática (ASSINF) e Superintendência Administrativa (SUPAD)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS_02" name="Gabinete do Conselheiro-Relator (CONS-02)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CT" name="Câmaras técnicas (CAENE e CAPET)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária, agentes do mercado livre e interessados">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Deliberação, requerimento ou contrato protocolado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Notificar concessionária e distribuir ao relator&#10;[100% de 11 casos · espera 3 du · 0,3 h]">
      <bpmn:documentation>freq: 100% de 11; du: 3; horas: 0,3 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Requisitar documentos e convocar reuniões com partes&#10;[91% de 11 casos · espera 4 du · 0,8 h]">
      <bpmn:documentation>freq: 91% de 11; du: 4; horas: 0,8 h; status: perda; nota: Perda: aguardando outra unidade (50%), prazo concedido (50%)</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Minuta, documentos ou manifestação recebidos">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Elaborar parecer técnico e minuta regulatória&#10;[64% de 11 casos · espera 0 du · 0,5 h]">
      <bpmn:documentation>freq: 64% de 11; du: 0; horas: 0,5 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>

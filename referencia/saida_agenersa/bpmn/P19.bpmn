      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t10" name="Esclarecer dúvida técnica apontada na instrução&#10;[45% de 11 casos · espera 1,5 du · 1 h]">
      <bpmn:documentation>freq: 45% de 11; du: 1,5; horas: 1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j3" name="">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t11" name="Notificar partes para apresentar razões finais&#10;[36% de 11 casos · espera 1 du · 0,8 h]">

      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Divulgar peças no portal e na imprensa&#10;[55% de 11 casos · espera 0 du · 0,2 h]">
      <bpmn:documentation>freq: 55% de 11; du: 0; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>

      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Requisitar documentos à concessionária e a órgãos&#10;[33% de 12 casos · espera 11,5 du · 1,4 h]">
      <bpmn:documentation>freq: 33% de 12; du: 11,5; horas: 1,4 h; status: perda; nota: Perda: pedido complementacao (100%), diligencia externa (75%)</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>

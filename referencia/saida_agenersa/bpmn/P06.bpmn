<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P06" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P06">
    <bpmn:participant id="Part_P06" name="P06 — Fiscalização técnica de campo (programada e por demanda) (AS-IS · 12 casos · procedimento)" processRef="Processo_P06" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P06" isExecutable="false">
    <bpmn:documentation>Da vistoria in loco à publicação da deliberação e ao registro das providências de cumprimento Fontes: Casos SEI-480002/007520/2025 (típico) e SEI-480002/005546/2024 (crítico); devoluções do relator à Procuradoria (23) e às câmaras técnicas (22) nas trilhas dos 32 processos do código. Revisado com as peças fora do modelo dos 12 processos da coorte: a notificação da concessionária pela Secretaria para manifestar-se sobre o parecer (5 processos) e a decisão sobre pedidos de dilação de prazo (2 processos) viraram tarefas; o termo de encerramento entrou na saída do registro de cumprimento. Ficaram fora, por aparecerem em um único processo: concessão de acesso aos autos a terceiro e decisões cautelares do Conselho-Diretor em reunião interna. Cartas e ofícios da concessionária, do município e de órgãos externos são entradas, não tarefas.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P06">
      <bpmn:lane id="Lane_CT" name="Câmara técnica de fiscalização (CAENE ou CASAN)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS" name="Conselheiro-Relator / Conselho-Diretor (CONS-02)">
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária, órgãos externos e município">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Fiscalização programada ou demanda recebida">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Vistoriar instalação, relatar e notificar concessionária&#10;[92% de 12 casos · espera 0 du · 7,4 h]">
      <bpmn:documentation>freq: 92% de 12; du: 0; horas: 7,4 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Defesa ou documentos da concessionária recebidos">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>

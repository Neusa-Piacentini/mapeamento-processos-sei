      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Sortear relator e distribuir o processo&#10;[100% de 12 casos · espera 15 du · 0,1 h]">
      <bpmn:documentation>freq: 100% de 12; du: 15; horas: 0,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>

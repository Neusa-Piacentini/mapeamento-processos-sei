      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Analisar defesa e emitir parecer técnico&#10;[92% de 12 casos · espera 9,5 du · 3 h]">
      <bpmn:documentation>freq: 92% de 12; du: 9,5; horas: 3 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>

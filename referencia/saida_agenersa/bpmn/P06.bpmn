      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Analisar infração e emitir parecer jurídico&#10;[92% de 12 casos · espera 36,5 du · 4 h]">
      <bpmn:documentation>freq: 92% de 12; du: 36,5; horas: 4 h; status: espera; nota: Espera mediana 36,5 du (q3 75)</bpmn:documentation>

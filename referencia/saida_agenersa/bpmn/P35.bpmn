<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P35" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P35">
    <bpmn:participant id="Part_P35" name="P35 — Gestão de interrupções e crises de abastecimento (AS-IS · 7 casos · procedimento)" processRef="Processo_P35" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P35" isExecutable="false">
    <bpmn:documentation>Da ocorrência noticiada (ou plano de contingência protocolado) à deliberação, embargos e encerramento Fontes: Casos SEI-220007/002039/2022 (típico, plano de contingência) e SEI-220007/000992/2022 (crítico, rompimento de adutora); 20 processos do código.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P35">
      <bpmn:lane id="Lane_CT" name="Câmara técnica (CASAN ou CAENE)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAPET" name="Câmara de Política Econômica e Tarifária (CAPET)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS" name="Conselheiro-Relator / Conselho-Diretor (CONS-02)">
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Interrupção noticiada ou plano de contingência protocolado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Oficiar concessionária e vistoriar a ocorrência&#10;[71% de 7 casos · espera 2 du · 5,3 h]">
      <bpmn:documentation>freq: 71% de 7; du: 2; horas: 5,3 h; status: perda; nota: Perda: pedido complementacao (60%)</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Justificativa, laudo ou plano recebido">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t2" name="Analisar justificativa e emitir parecer técnico&#10;[100% de 7 casos · espera 39,5 du · 3,6 h]">
      <bpmn:documentation>freq: 100% de 7; du: 39,5; horas: 3,6 h; status: espera; nota: Espera mediana 39,5 du (q3 104,8)</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Analisar descumprimento e emitir parecer jurídico&#10;[86% de 7 casos · espera 29 du · 2 h]">
      <bpmn:documentation>freq: 86% de 7; du: 29; horas: 2 h; status: espera; nota: Espera mediana 29 du (q3 85); Perda: aguardando outra unidade (50%)</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Instrução suficiente?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Complementar análise técnica do descumprimento&#10;[29% de 7 casos · espera 8 du · 2 h]">
      <bpmn:documentation>freq: 29% de 7; du: 8; horas: 2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Apurar despesas do sinistro junto à concessionária&#10;[43% de 7 casos · espera 3 du · 0,1 h]">
      <bpmn:documentation>freq: 43% de 7; du: 3; horas: 0,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j0" name="">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Notificar concessionária para manifestação&#10;[71% de 7 casos · espera 0,5 du · 0,8 h]">
      <bpmn:documentation>freq: 71% de 7; du: 0,5; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo de manifestação decorrido">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Concessionária respondeu?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t7" name="Distribuir ao relator (sorteio ou prevenção)&#10;[86% de 7 casos · espera 6 du · 0,2 h]">
      <bpmn:documentation>freq: 86% de 7; du: 6; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j3" name="">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="Notificar concessionária para razões finais&#10;[71% de 7 casos · espera 3,5 du · 0,8 h]">
      <bpmn:documentation>freq: 71% de 7; du: 3,5; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e3" name="Razões finais apresentadas">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t9" name="Relatar, votar e deliberar em sessão&#10;[71% de 7 casos · espera 58,5 du · 6 h]">
      <bpmn:documentation>freq: 71% de 7; du: 58,5; horas: 6 h; status: espera; nota: Espera mediana 58,5 du (q3 87)</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Publicar deliberação e notificar concessionária&#10;[71% de 7 casos · espera 6 du · 0,6 h]">
      <bpmn:documentation>freq: 71% de 7; du: 6; horas: 0,6 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g3" name="Embargos de declaração opostos?">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t11" name="Analisar embargos de declaração&#10;[14% de 7 casos · espera 24 du · 6 h]">
      <bpmn:documentation>freq: 14% de 7; du: 24; horas: 6 h; status: espera; nota: Espera mediana 24 du (q3 24); Perda: prazo concedido (100%), refazimento (100%)</bpmn:documentation>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Registrar cumprimento e encerrar o processo&#10;[71% de 7 casos · espera 0 du · 0,6 h]">
      <bpmn:documentation>freq: 71% de 7; du: 0; horas: 0,6 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Deliberação cumprida">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>

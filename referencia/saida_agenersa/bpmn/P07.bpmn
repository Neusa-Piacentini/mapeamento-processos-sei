<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P07" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P07">
    <bpmn:participant id="Part_P07" name="P07 — Processo sancionador (auto de infração à cobrança da multa) (AS-IS · 3 casos · estudo de caso)" processRef="Processo_P07" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P07" isExecutable="false">
    <bpmn:documentation>Da deliberação que aplica a penalidade ao auto de infração, à contestação e à notificação para razões finais Fontes: Estudo de caso: só 3 processos do código na coorte, nenhum encerrado; o modelo descreve os ramos observados, não um padrão consolidado. Casos SEI-220007/001772/2020 (multa, ação anulatória e tratativas de acordo), SEI-480002/000089/2024 (advertência com impugnação; só peças do relator) e SEI-480002/004480/2025 (processo de autocomposição das multas). Evidências em saida/bpmn/evidencias_P07.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P07">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CT" name="Câmaras técnicas (CAPET, CASAN ou CARES)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS" name="Conselheiro-Relator e Presidência (CONS-02, CONS-04, CONS-05, PRESI)">
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária e mediação da PGE">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Deliberação do Conselho-Diretor aplicando penalidade publicada">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g1" name="Penalidade de multa?">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Calcular o valor da multa&#10;[33% de 3 casos · espera 1 du · 0,5 h]">
      <bpmn:documentation>freq: 33% de 3; du: 1; horas: 0,5 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Lavrar minuta do auto de infração&#10;[67% de 3 casos · espera 8 du · 1,2 h]">
      <bpmn:documentation>freq: 67% de 3; du: 8; horas: 1,2 h; status: perda; nota: Perda: aguardando outra unidade (50%)</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Conferir conformidade da minuta do auto&#10;[67% de 3 casos · espera 5 du · 3 h]">
      <bpmn:documentation>freq: 67% de 3; du: 5; horas: 3 h; status: perda; nota: Perda: pedido complementacao (50%)</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Assinar o auto de infração&#10;[67% de 3 casos · espera 0 du · 0,2 h]">
      <bpmn:documentation>freq: 67% de 3; du: 0; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Notificar concessionária do auto de infração&#10;[33% de 3 casos · espera 1 du · 1,2 h]">
      <bpmn:documentation>freq: 33% de 3; du: 1; horas: 1,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Contestação da concessionária recebida">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g2" name="Contestação por impugnação administrativa?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Analisar impugnação ao auto de infração&#10;[33% de 3 casos · espera 9 du · 6 h]">
      <bpmn:documentation>freq: 33% de 3; du: 9; horas: 6 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Comunicar resultado da impugnação à concessionária&#10;[33% de 3 casos · espera 2 du · 1,8 h]">
      <bpmn:documentation>freq: 33% de 3; du: 2; horas: 1,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Recomendar submissão ao Conselho-Diretor&#10;[33% de 3 casos · espera 12 du · 4 h]">
      <bpmn:documentation>freq: 33% de 3; du: 12; horas: 4 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Remeter ao gabinete do relator sorteado&#10;[100% de 3 casos · espera 15 du · 0,2 h]">
      <bpmn:documentation>freq: 100% de 3; du: 15; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t10" name="Acompanhar ação judicial e consultar a PGE&#10;[33% de 3 casos · espera 26 du · 0,2 h]">
      <bpmn:documentation>freq: 33% de 3; du: 26; horas: 0,2 h; status: espera; nota: Espera mediana 26 du (q3 48); Perda: aguardando outra unidade (100%), sobrestamento (100%)</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="Negociar acordo na câmara de mediação&#10;[67% de 3 casos · espera 41,5 du · 0,1 h]">
      <bpmn:documentation>freq: 67% de 3; du: 41,5; horas: 0,1 h; status: espera; nota: Espera mediana 41,5 du (q3 47,8)</bpmn:documentation>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Propor processo de autocomposição ao Conselho-Diretor&#10;[67% de 3 casos · espera 11 du · 0,2 h]">
      <bpmn:documentation>freq: 67% de 3; du: 11; horas: 0,2 h; status: perda; nota: Perda: aguardando outra unidade (50%)</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="Registrar e publicar decisão de instauração&#10;[33% de 3 casos · espera 9 du · 0,2 h]">
      <bpmn:documentation>freq: 33% de 3; du: 9; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="Atualizar valores das multas aplicadas&#10;[67% de 3 casos · espera 2 du · 1,5 h]">
      <bpmn:documentation>freq: 67% de 3; du: 2; horas: 1,5 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t15" name="Emitir parecer sobre a minuta de autocomposição&#10;[67% de 3 casos · espera 92 du · 0,6 h]">
      <bpmn:documentation>freq: 67% de 3; du: 92; horas: 0,6 h; status: espera; nota: Espera mediana 92 du (q3 121); Perda: aguardando outra unidade (50%), pedido complementacao (50%)</bpmn:documentation>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t16" name="Informar resultado da mediação&#10;[67% de 3 casos · espera 0 du · 2 h]">
      <bpmn:documentation>freq: 67% de 3; du: 0; horas: 2 h; status: perda; nota: Perda: aguardando outra unidade (50%), pedido complementacao (50%)</bpmn:documentation>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t17" name="Notificar concessionária para razões finais&#10;[67% de 3 casos · espera 7,5 du · 0,8 h]">
      <bpmn:documentation>freq: 67% de 3; du: 7,5; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo de razões finais decorrido">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="f1" name="Processo em relatoria aguardando deliberação">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>

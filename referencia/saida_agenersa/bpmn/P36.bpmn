<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P36" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P36">
    <bpmn:participant id="Part_P36" name="P36 — Regulação comercial — contrato especial de grande usuário (AS-IS)" processRef="Processo_P36" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P36" isExecutable="false">
    <bpmn:documentation>Do pleito de contrato com condições especiais para grande usuário à deliberação e encerramento Fontes: Caso SEI-480002/008679/2025 (típico, único do piloto: Rio+ Saneamento e Ternium); 7 processos do código (4 nativos). Evidências em saida/bpmn/evidencias_P36.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P36">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_REG" name="Assessoria Regulatória (REG)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS_02" name="Conselheiro-Relator / Conselho-Diretor (CONS-02)">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária e grande usuário">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Pleito de contrato especial protocolado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Enquadrar pleito e encaminhar à Procuradoria&#10;[1/1 casos · espera 7 du · 1 h]">
      <bpmn:documentation>freq: 1/1; du: 7; horas: 1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Analisar minuta de contrato especial&#10;[1/1 casos · espera 26 du · 8–34 h]">
      <bpmn:documentation>freq: 1/1; du: 26; horas: 8–34 h; status: espera; nota: Espera com PROC 25 du, REG 1 du</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Minuta exige ajustes?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e1" name="Minuta ajustada recebida da concessionária">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Verificar incorporação das recomendações jurídicas&#10;[1/1 casos · espera 26 du · 1 h]">
      <bpmn:documentation>freq: 1/1; du: 26; horas: 1 h; status: espera; nota: Espera com REG 10 du, SCEXEC 8 du</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Notificar concessionária para razões finais&#10;[1/1 casos · espera 17 du · 1–2 h]">
      <bpmn:documentation>freq: 1/1; du: 17; horas: 1–2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo de razões finais decorrido">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Relatar, votar e deliberar a minuta&#10;[1/1 casos · espera 20 du · 7–19 h]">
      <bpmn:documentation>freq: 1/1; du: 20; horas: 7–19 h; status: espera; nota: Espera com CONS-02 20 du; Perda: pedido de complementação</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Publicar deliberação e oficiar concessionária e INEA&#10;[1/1 casos · espera 8 du · 3–5 h]">
      <bpmn:documentation>freq: 1/1; du: 8; horas: 3–5 h; status: perda; nota: Perda: repetição de peça anterior</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Encerrar e arquivar o processo&#10;[1/1 casos · espera 62 du · 0–1 h]">
      <bpmn:documentation>freq: 1/1; du: 62; horas: 0–1 h; status: espera; nota: Espera com CONS-02 48 du, SEM UNIDADE 12 du</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Contrato homologado e processo encerrado">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" name="Não" sourceRef="g1" targetRef="t4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" name="Sim" sourceRef="g1" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="e1" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="t3" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="t4" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="e2" targetRef="t5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="t5" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="t7" targetRef="f1"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Nota_0"><bpmn:text>Espera com PROC 25 du, REG 1 du</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_0" sourceRef="t2" targetRef="Nota_0" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Espera com REG 10 du, SCEXEC 8 du</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="t3" targetRef="Nota_1" />
    <bpmn:textAnnotation id="Nota_2"><bpmn:text>Espera com CONS-02 20 du; Perda: pedido de complementação</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="t5" targetRef="Nota_2" />
    <bpmn:textAnnotation id="Nota_3"><bpmn:text>Perda: repetição de peça anterior</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="t6" targetRef="Nota_3" />
    <bpmn:textAnnotation id="Nota_4"><bpmn:text>Espera com CONS-02 48 du, SEM UNIDADE 12 du</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="t7" targetRef="Nota_4" />
  </bpmn:process>

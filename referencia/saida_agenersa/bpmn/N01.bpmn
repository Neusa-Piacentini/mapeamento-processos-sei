      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Analisar o caso e emitir parecer técnico&#10;[82% de 11 casos · espera 35,5 du · 4,2 h]">

      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t3" name="Comunicar dilação de prazo à concessionária&#10;[45% de 11 casos · espera 7 du · 0,5 h]">
      <bpmn:documentation>freq: 45% de 11; du: 7; horas: 0,5 h; status: perda; nota: Perda: prazo concedido (80%)</bpmn:documentation>

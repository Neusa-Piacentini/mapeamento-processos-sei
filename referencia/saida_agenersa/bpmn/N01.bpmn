  <bpmn:collaboration id="Colab_N01">
    <bpmn:participant id="Part_N01" name="N01 — Acompanhamento ambiental e de mananciais das concessões (AS-IS · 11 casos · procedimento)" processRef="Processo_N01" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_N01" isExecutable="false">
    <bpmn:documentation>Da comunicação de auto ambiental ou demanda de acompanhamento à deliberação e arquivamento Fontes: Casos E-22/007.102/2020 (mananciais do Guandu), SEI-220007/004173/2022 (odor de ETE, penalidade sugerida), SEI-480002/004134/2025 (auto de multa municipal, IN 49/2015) e SEI-480002/000725/2024 (auto municipal, encerramento sugerido); recorrência conferida nos demais processos do código, inclusive os só com peças do relator. Relatório, voto, publicação e encerramento só aparecem concluídos em E-12/020.787/2012. 12 processos do código (5 nativos, 3 migrados, 4 só com peças do relator). Evidências em saida/bpmn/evidencias_N01.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_N01">
      <bpmn:lane id="Lane_CONS_02" name="Gabinete do Conselheiro-Relator (CONS-02)">

        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária, órgão ambiental e prefeitura">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Auto ambiental comunicado ou demanda de acompanhamento recebida">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g0" name="Auto ambiental comunicado pela concessionária?">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Solicitar informações à concessionária&#10;[64% de 11 casos · espera 48 du · 1,2 h]">
      <bpmn:documentation>freq: 64% de 11; du: 48; horas: 1,2 h; status: espera; nota: Espera mediana 48 du (q3 331,5); Perda: diligencia externa (71%)</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Requisitar informações à concessionária e à prefeitura&#10;[45% de 11 casos · espera 13 du · 0,8 h]">
      <bpmn:documentation>freq: 45% de 11; du: 13; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>

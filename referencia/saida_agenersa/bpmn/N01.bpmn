      <bpmn:documentation>freq: 45% de 11; du: 1; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>

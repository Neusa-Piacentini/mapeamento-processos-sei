<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P22" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P22">
    <bpmn:participant id="Part_P22" name="P22 — Resposta a órgãos de controle e ao Ministério Público (AS-IS · 8 casos · procedimento)" processRef="Processo_P22" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P22" isExecutable="false">
    <bpmn:documentation>Do ofício do Ministério Público à apuração, deliberação de penalidade e encerramento Fontes: Caso SEI-480002/003768/2024 (típico, único do piloto: denúncia do MPRJ sobre desabastecimento em Campo Grande); 12 processos do código (9 nativos). Evidências em saida/bpmn/evidencias_P22.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P22">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OUV" name="Ouvidoria (OUV)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara de Saneamento (CASAN)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS_02" name="Conselheiro-Relator / Conselho-Diretor (CONS-02)">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Ofício do MPRJ com denúncia recebido">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Atestar descumprimento de prazo da concessionária&#10;[88% de 8 casos · espera 6,5 du · 0,3 h]">
      <bpmn:documentation>freq: 88% de 8; du: 6,5; horas: 0,3 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Oficiar concessionária com prazo de resposta&#10;[75% de 8 casos · espera 3 du · 1,2 h]">
      <bpmn:documentation>freq: 75% de 8; du: 3; horas: 1,2 h; status: perda; nota: Perda: diligencia externa (67%), prazo concedido (50%)</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Esclarecimentos da concessionária recebidos">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Esclarecimentos suficientes?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo de instrução da CASAN vencido">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Reiterar prazo de instrução à CASAN&#10;[75% de 8 casos · espera 2,5 du · 0,5 h]">
      <bpmn:documentation>freq: 75% de 8; du: 2,5; horas: 0,5 h; status: perda; nota: Perda: prazo concedido (67%), reiteracao (50%)</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Analisar denúncia e apurar descumprimento&#10;[75% de 8 casos · espera 4 du · 3,1 h]">
      <bpmn:documentation>freq: 75% de 8; du: 4; horas: 3,1 h; status: perda; nota: Perda: pedido complementacao (50%)</bpmn:documentation>
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Opinar sobre descumprimento e penalidade&#10;[100% de 8 casos · espera 31 du · 4 h]">
      <bpmn:documentation>freq: 100% de 8; du: 31; horas: 4 h; status: espera; nota: Espera mediana 31 du (q3 96)</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t6" name="Notificar concessionária para razões finais&#10;[88% de 8 casos · espera 73 du · 0,8 h]">
      <bpmn:documentation>freq: 88% de 8; du: 73; horas: 0,8 h; status: espera; nota: Espera mediana 73 du (q3 96,5)</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e3" name="Prazo de razões finais decorrido">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t7" name="Relatar, votar e aplicar penalidade&#10;[50% de 8 casos · espera 55,5 du · 7,2 h]">
      <bpmn:documentation>freq: 50% de 8; du: 55,5; horas: 7,2 h; status: espera; nota: Espera mediana 55,5 du (q3 59,8); Perda: reiteracao (50%)</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Publicar deliberação e notificar concessionária&#10;[38% de 8 casos · espera 6 du · 2,6 h]">
      <bpmn:documentation>freq: 38% de 8; du: 6; horas: 2,6 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Certificar ausência de recurso e encerrar&#10;[12% de 8 casos · espera 88 du · 1 h]">
      <bpmn:documentation>freq: 12% de 8; du: 88; horas: 1 h; status: espera; nota: Espera mediana 88 du (q3 88); Perda: refazimento (100%)</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo encerrado com penalidade aplicada">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>

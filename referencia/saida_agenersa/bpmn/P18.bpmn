<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P18" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P18">
    <bpmn:participant id="Part_P18" name="P18 — Prorrogação, relicitação e alteração de concessões (AS-IS · 10 casos · procedimento)" processRef="Processo_P18" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P18" isExecutable="false">
    <bpmn:documentation>Da decisão do Conselho-Diretor que abre um processo por município atendido pela CEDAE à juntada do termo aditivo ou à notificação do município e à distribuição ao relator Fontes: Casos SEI-480002/008862/2025, SEI-480002/008863/2025 e SEI-480002/008865/2025 (só peças, sem trâmite); 10 processos do código, dos quais 9 são termos aditivos da CEDAE por município. O caso migrado E-12/003.100035/2018 (cumprimento de deliberação de gás com ação judicial) não segue este fluxo. Revisado após a auditoria às cegas: a juntada da decisão do Conselho-Diretor na abertura passou a ser parte explícita da primeira atividade.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P18">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAPET" name="Câmara de Política Econômica e Tarifária (CAPET)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="CEDAE e municípios">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Processo originário desdobrado por município">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Juntar decisão do CODIR e abrir processo municipal&#10;[100% de 10 casos · espera 815 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 10; du: 815; horas: 0,8 h; status: espera; nota: Espera mediana 815 du (q3 815); Perda: refazimento (50%)</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Verificar pendências documentais do município&#10;[90% de 10 casos · espera 3 du · 1 h]">
      <bpmn:documentation>freq: 90% de 10; du: 3; horas: 1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Oficiar CEDAE sobre abertura dos processos&#10;[90% de 10 casos · espera 6 du · 0,1 h]">
      <bpmn:documentation>freq: 90% de 10; du: 6; horas: 0,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Manifestação da CEDAE sobre termos aditivos">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Termo aditivo celebrado com o município?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Juntar termo aditivo e publicação no DOERJ&#10;[50% de 10 casos · espera 19 du · 1,1 h]">
      <bpmn:documentation>freq: 50% de 10; du: 19; horas: 1,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Notificar município sobre urgência do aditivo&#10;[40% de 10 casos · espera 43,5 du · 2,1 h]">
      <bpmn:documentation>freq: 40% de 10; du: 43,5; horas: 2,1 h; status: espera; nota: Espera mediana 43,5 du (q3 50)</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo da notificação decorrido">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t6" name="Reiterar notificação ao município&#10;[40% de 10 casos · espera 138 du · 0,8 h]">
      <bpmn:documentation>freq: 40% de 10; du: 138; horas: 0,8 h; status: espera; nota: Espera mediana 138 du (q3 141,2); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Encaminhar processo ao relator por prevenção&#10;[100% de 10 casos · espera 120,5 du · 0,2 h]">
      <bpmn:documentation>freq: 100% de 10; du: 120,5; horas: 0,2 h; status: espera; nota: Espera mediana 120,5 du (q3 180)</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Município respondeu à notificação?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="e3" name="Resposta do município recebida">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t8" name="Juntar resposta do município&#10;[10% de 10 casos · espera 4 du · 0,3 h]">
      <bpmn:documentation>freq: 10% de 10; du: 4; horas: 0,3 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo no gabinete do relator">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="e1" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" name="Sim · 56%" sourceRef="g1" targetRef="t4"><bpmn:documentation>5 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="Não · 44%" sourceRef="g1" targetRef="t5"><bpmn:documentation>4 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="t5" targetRef="e2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="e2" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="t4" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="t7" targetRef="g2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" name="Não · 90%" sourceRef="g2" targetRef="f1"><bpmn:documentation>9 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="Sim · 10%" sourceRef="g2" targetRef="e3"><bpmn:documentation>1 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="e3" targetRef="t8"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" sourceRef="t8" targetRef="f1"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Nota_0"><bpmn:text>Espera mediana 815 du (q3 815); Perda: refazimento (50%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_0" sourceRef="t1" targetRef="Nota_0" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Espera mediana 43,5 du (q3 50)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="t5" targetRef="Nota_1" />
    <bpmn:textAnnotation id="Nota_2"><bpmn:text>Espera mediana 138 du (q3 141,2); Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="t6" targetRef="Nota_2" />
    <bpmn:textAnnotation id="Nota_3"><bpmn:text>Espera mediana 120,5 du (q3 180)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="t7" targetRef="Nota_3" />
  </bpmn:process>

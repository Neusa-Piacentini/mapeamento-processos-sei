<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P03" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P03">
    <bpmn:participant id="Part_P03" name="P03 — Reequilíbrio econômico-financeiro e aditivos contratuais (AS-IS)" processRef="Processo_P03" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P03" isExecutable="false">
    <bpmn:documentation>Do protocolo do pleito de reequilíbrio à deliberação do Conselho-Diretor e encerramento Fontes: Caso SEI-220007/001749/2022 (típico, único do piloto; lead time de 710 du); 6 processos do código. Evidências em saida/bpmn/evidencias_P03.md e fichas por documento.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P03">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara de Saneamento (CASAN)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS_02" name="Conselheiro-Relator / Conselho-Diretor (CONS-02)">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAPET" name="Câmara de Política Econômica e Tarifária (CAPET)">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária, Poder Concedente e terceiros">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Pleito de reequilíbrio protocolado e autuado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Analisar pleito e estudos da concessionária&#10;[1/1 casos · espera 18 du · 44–50 h]">
      <bpmn:documentation>freq: 1/1; du: 18; horas: 44–50 h; status: perda; nota: Perda: repetição de peça anterior, pedido de complementação</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Dados suficientes?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Solicitar dados complementares às partes&#10;[1/1 casos · espera 31 du · 11–12 h]">
      <bpmn:documentation>freq: 1/1; du: 31; horas: 11–12 h; status: espera; nota: Espera com CONS-02 25 du, CAPET 6 du; Perda: pedido de complementação, diligência externa</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Dados e esclarecimentos recebidos">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t3" name="Notificar concessionária e dar vista&#10;[1/1 casos · espera 13 du · 1–2 h]">
      <bpmn:documentation>freq: 1/1; du: 13; horas: 1–2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t4" name="Sortear relator em reunião interna&#10;[1/1 casos · espera 25 du · 0 h]">
      <bpmn:documentation>freq: 1/1; du: 25; horas: 0 h; status: espera; nota: Espera com PROC 18 du, SCEXEC 7 du</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t5" name="Diligenciar partes e convocar reuniões&#10;[1/1 casos · espera 87 du · 8–9 h]">
      <bpmn:documentation>freq: 1/1; du: 87; horas: 8–9 h; status: espera; nota: Espera com CONS-02 86 du, SCEXEC 1 du; Perda: repetição de peça anterior, pedido de complementação</bpmn:documentation>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e2" name="Informações e propostas das partes recebidas">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t6" name="Recalcular TIR e propor cenários de reequilíbrio&#10;[1/1 casos · espera 50 du · 56–86 h]">
      <bpmn:documentation>freq: 1/1; du: 50; horas: 56–86 h; status: espera; nota: Espera com CAPET 50 du; Perda: pedido de complementação, prazo concedido</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Declarar ausência de escopo técnico&#10;[1/1 casos · espera 15 du · 0–1 h]">
      <bpmn:documentation>freq: 1/1; du: 15; horas: 0–1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t8" name="Analisar viabilidade jurídica do reequilíbrio&#10;[1/1 casos · espera 75 du · 12–33 h]">
      <bpmn:documentation>freq: 1/1; du: 75; horas: 12–33 h; status: espera; nota: Espera com CONS-02 50 du, PROC 25 du; Perda: aguardando outra unidade, pedido de complementação</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Instrução técnica concluída?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t9" name="Notificar partes para razões finais&#10;[1/1 casos · espera 0 du · 2–3 h]">
      <bpmn:documentation>freq: 1/1; du: 0; horas: 2–3 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e3" name="Razões finais e anuência do Município recebidas">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g3" name="Cenários exigem complementação técnica?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t10" name="Complementar cenários tarifários&#10;[1/1 casos · espera 0 du · 25–40 h]">
      <bpmn:documentation>freq: 1/1; du: 0; horas: 25–40 h; status: perda; nota: Perda: repetição de peça anterior, aguardando outra unidade</bpmn:documentation>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t11" name="Relatar, votar e deliberar o reequilíbrio&#10;[1/1 casos · espera 2 du · 28–40 h]">
      <bpmn:documentation>freq: 1/1; du: 2; horas: 28–40 h; status: perda; nota: Perda: pedido de complementação, aguardando outra unidade</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t12" name="Publicar deliberação e registrar termo&#10;[1/1 casos · espera 70 du · 0 h]">
      <bpmn:documentation>freq: 1/1; du: 70; horas: 0 h; status: espera; nota: Espera com CONS-04 35 du, SCEXEC 26 du</bpmn:documentation>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t13" name="Encerrar e arquivar o processo&#10;[1/1 casos · espera 1 du · 0 h]">
      <bpmn:documentation>freq: 1/1; du: 1; horas: 0 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo encerrado">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>

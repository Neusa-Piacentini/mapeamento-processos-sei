<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P06" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P06">
    <bpmn:participant id="Part_P06" name="P06 — Fiscalização técnica de campo (programada e por demanda) (AS-IS · 1 casos · estudo de caso)" processRef="Processo_P06" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P06" isExecutable="false">
    <bpmn:documentation>Do ciclo anual de vistorias programadas nas unidades da concessionária à ciência dos pareceres técnico e jurídico e ao sobrestamento para acompanhamento das providências Fontes: Estudo de caso único SEI-480002/001314/2024 (fiscalizações programadas de 2024, Águas do Rio – Bloco 1): relatórios de fiscalização, ofícios da CASAN, Parecer CASAN 250/2025, despacho da CASAN de 30/10/2025, Parecer PROC 759/2025 e ofício de ciência de 28/08/2026.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P06">
      <bpmn:lane id="Lane_CASAN" name="Câmara Técnica de Saneamento (CASAN)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária (Águas do Rio – Bloco 1)">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Ciclo anual de vistorias programadas aberto">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t1" name="Agendar vistoria com a concessionária&#10;[100% de 1 casos · espera 8,5 du · 2 h]">
      <bpmn:documentation>freq: 100% de 1; du: 8,5; horas: 2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Vistoriar unidade e emitir relatório de fiscalização&#10;[100% de 1 casos · espera 10,5 du · 30,5 h]">
      <bpmn:documentation>freq: 100% de 1; du: 10,5; horas: 30,5 h; status: perda; nota: Perda: pedido complementacao (100%), prazo concedido (100%)</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Encaminhar lote de relatórios à concessionária&#10;[100% de 1 casos · espera 6 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 1; du: 6; horas: 0,8 h; status: perda; nota: Perda: prazo concedido (100%)</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Respostas e planos de ação da concessionária recebidos">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g1" name="Restam unidades a vistoriar no ciclo?">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Analisar providências e emitir parecer técnico&#10;[100% de 1 casos · espera 106 du · 16,1 h]">
      <bpmn:documentation>freq: 100% de 1; du: 106; horas: 16,1 h; status: espera; nota: Espera mediana 106 du (q3 106); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j2" name="">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t5" name="Dar ciência do parecer à concessionária&#10;[100% de 1 casos · espera 130 du · 0,6 h]">
      <bpmn:documentation>freq: 100% de 1; du: 130; horas: 0,6 h; status: espera; nota: Espera mediana 130 du (q3 167,5)</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Concessionária contestou a fiscalização?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Responder contestação da concessionária&#10;[100% de 1 casos · espera 26 du · 2 h]">
      <bpmn:documentation>freq: 100% de 1; du: 26; horas: 2 h; status: espera; nota: Espera mediana 26 du (q3 26); Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Emitir parecer jurídico sobre a fiscalização&#10;[100% de 1 casos · espera 0 du · 6 h]">
      <bpmn:documentation>freq: 100% de 1; du: 0; horas: 6 h; status: perda; nota: Perda: reiteracao (100%)</bpmn:documentation>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Processo sobrestado para acompanhamento das providências">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="j1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="j1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="t1" targetRef="t2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F3" sourceRef="t2" targetRef="t3"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4" sourceRef="t3" targetRef="e1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="e1" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" name="Não" sourceRef="g1" targetRef="t4"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" name="Sim" sourceRef="g1" targetRef="j1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="t4" targetRef="j2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="j2" targetRef="t5"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10" sourceRef="t5" targetRef="g2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="Não" sourceRef="g2" targetRef="f1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" name="Sim" sourceRef="g2" targetRef="t6"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="t7" targetRef="j2"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="Nota_0"><bpmn:text>Perda: pedido complementacao (100%), prazo concedido (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_0" sourceRef="t2" targetRef="Nota_0" />
    <bpmn:textAnnotation id="Nota_1"><bpmn:text>Perda: prazo concedido (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="t3" targetRef="Nota_1" />
    <bpmn:textAnnotation id="Nota_2"><bpmn:text>Espera mediana 106 du (q3 106); Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="t4" targetRef="Nota_2" />
    <bpmn:textAnnotation id="Nota_3"><bpmn:text>Espera mediana 130 du (q3 167,5)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="t5" targetRef="Nota_3" />
    <bpmn:textAnnotation id="Nota_4"><bpmn:text>Espera mediana 26 du (q3 26); Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="t6" targetRef="Nota_4" />
    <bpmn:textAnnotation id="Nota_5"><bpmn:text>Perda: reiteracao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_5" sourceRef="t7" targetRef="Nota_5" />
  </bpmn:process>

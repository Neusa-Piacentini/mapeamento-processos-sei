      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e2" name="Prazo de resposta decorrido">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Reiterar ofício de diligência&#10;[33% de 18 casos · espera 9,5 du · 0,8 h]">
      <bpmn:documentation>freq: 33% de 18; du: 9,5; horas: 0,8 h; status: perda; nota: Perda: reiteracao (100%)</bpmn:documentation>

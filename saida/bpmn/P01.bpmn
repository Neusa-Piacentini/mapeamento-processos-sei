      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t15" name="Lavrar decisão do Conselho em reunião interna&#10;[44% de 18 casos · espera 5 du · 0,2 h]">
      <bpmn:documentation>freq: 44% de 18; du: 5; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t16" name="Conceder acesso aos autos às partes&#10;[50% de 18 casos · espera 2 du · 0,8 h]">
      <bpmn:documentation>freq: 50% de 18; du: 2; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Notificar partes para razões finais&#10;[100% de 18 casos · espera 1 du · 0,8 h]">

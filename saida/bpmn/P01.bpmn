<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P01" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P01">
    <bpmn:participant id="Part_P01" name="P01 — Reajuste tarifário anual (AS-IS · 18 casos · procedimento)" processRef="Processo_P01" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P01" isExecutable="false">
    <bpmn:documentation>Do protocolo do pleito de reajuste à deliberação, publicação e encerramento do processo Fontes: Casos SEI-480002/001914/2024 (típico) e SEI-220007/004053/2022 (crítico); 29 processos do código (26 nativos). Revisado com as peças fora do modelo dos 18 processos da coorte: diligências e reiterações da Secretaria ao Poder Concedente e à concessionária (3 processos), decisões do Conselho-Diretor em reunião interna, cautelares ou de dilação do prazo de julgamento (4 processos) e concessão de acesso aos autos pelo relator (5 processos) viraram tarefas; votos e peças de outros conselheiros relatores passaram para a raia do Conselho. Ficaram fora, como entradas externas: relatório técnico de cálculo e comprovantes de divulgação do reajuste juntados pela concessionária; formalização do pleito exigida pela Secretaria (1 processo) entrou na saída do recebimento; mediação registrada pela Procuradoria e parecer jurídico sobre pedido de acesso (um único pedido juntado em 3 processos) não viraram tarefa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P01">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAPET" name="Câmara de Política Econômica e Tarifária (CAPET)">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS_02" name="Conselheiro-Relator / Conselho-Diretor (CONS-02, CONS-05, CONS-01, CODIR)">
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária, Poder Concedente e Verificador Independente">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Pleito de reajuste protocolado">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Acusar recebimento e sortear relator&#10;[100% de 18 casos · espera 1 du · 0,2 h]">
      <bpmn:documentation>freq: 100% de 18; du: 1; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t2" name="Calcular reajuste pela fórmula paramétrica&#10;[100% de 18 casos · espera 3 du · 4,1 h]">
      <bpmn:documentation>freq: 100% de 18; du: 3; horas: 4,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Analisar legalidade do reajuste&#10;[100% de 18 casos · espera 3 du · 4 h]">
      <bpmn:documentation>freq: 100% de 18; du: 3; horas: 4 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Instrução suficiente?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Diligenciar partes e verificador independente&#10;[50% de 18 casos · espera 2 du · 0,2 h]">
      <bpmn:documentation>freq: 50% de 18; du: 2; horas: 0,2 h; status: perda; nota: Perda: diligencia externa (67%)</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Resposta no prazo?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>

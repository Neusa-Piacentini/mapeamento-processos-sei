      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t14" name="Diligenciar Poder Concedente e concessionária&#10;[61% de 18 casos · espera 2 du · 0,2 h]">
      <bpmn:documentation>freq: 61% de 18; du: 2; horas: 0,2 h; status: normal</bpmn:documentation>

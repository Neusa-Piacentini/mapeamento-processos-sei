<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_P08" targetNamespace="https://agenersa.rj.gov.br/mapeamento" exporter="mapeamento-sei" exporterVersion="1">
  <bpmn:collaboration id="Colab_P08">
    <bpmn:participant id="Part_P08" name="P08 — Monitoramento de metas contratuais e do IDG (verificador independente) (AS-IS · 6 casos · procedimento)" processRef="Processo_P08" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_P08" isExecutable="false">
    <bpmn:documentation>Do relatório de metas ou proposta protocolada pela concessionária à deliberação do Conselho-Diretor, sua publicação e comunicação Fontes: Caso SEI-220007/003487/2023 (típico do piloto, Programa de Educação Ambiental) e trilhas dos 6 processos da coorte; fase do relator a partir de SEI-480002/004357/2024 e E-22/007.16/2020. Revisado após a auditoria às cegas: a Procuradoria emite parecer de mérito na maior parte das consultas (antes só a restituição sem parecer estava no modelo) e a fase do relator não estava modelada.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_P08">
      <bpmn:lane id="Lane_SCEXEC" name="Secretaria Executiva (SCEXEC)">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PROC" name="Procuradoria (PROC)">
        <bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CONS" name="Conselheiro-Relator / Conselho-Diretor (CONS-02, CONS-05, CONS-01)">
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CASAN" name="Câmara de Saneamento (CASAN)">
        <bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EXT" name="Concessionária">
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Relatório de metas ou proposta protocolada pela concessionária">
      <bpmn:outgoing>F0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t1" name="Acusar recebimento e remeter à CASAN&#10;[100% de 6 casos · espera 3,5 du · 0,6 h]">
      <bpmn:documentation>freq: 100% de 6; du: 3,5; horas: 0,6 h; status: perda; nota: Perda: aguardando outra unidade (50%)</bpmn:documentation>
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j1" name="">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t2" name="Analisar metas e indicadores e emitir parecer&#10;[100% de 6 casos · espera 16 du · 4,4 h]">
      <bpmn:documentation>freq: 100% de 6; du: 16; horas: 4,4 h; status: perda; nota: Perda: pedido complementacao (50%)</bpmn:documentation>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t3" name="Notificar concessionária e conceder prazo&#10;[100% de 6 casos · espera 1,5 du · 0,8 h]">
      <bpmn:documentation>freq: 100% de 6; du: 1,5; horas: 0,8 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="e1" name="Prazo de manifestação decorrido">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_e1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t5" name="Reanalisar após manifestação e emitir parecer final&#10;[100% de 6 casos · espera 4 du · 2,1 h]">
      <bpmn:documentation>freq: 100% de 6; du: 4; horas: 2,1 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g1" name="Consulta jurídica necessária?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="j2" name="">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t4" name="Emitir parecer jurídico ou restituir os autos&#10;[83% de 6 casos · espera 13 du · 2 h]">
      <bpmn:documentation>freq: 83% de 6; du: 13; horas: 2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="j3" name="">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t6" name="Consolidar instrução e distribuir ao relator&#10;[100% de 6 casos · espera 12 du · 0,2 h]">
      <bpmn:documentation>freq: 100% de 6; du: 12; horas: 0,2 h; status: normal</bpmn:documentation>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t7" name="Instruir no gabinete e oficiar concessionária&#10;[33% de 6 casos · espera 4 du · 0,8 h]">
      <bpmn:documentation>freq: 33% de 6; du: 4; horas: 0,8 h; status: perda; nota: Perda: aguardando outra unidade (100%), diligencia externa (50%)</bpmn:documentation>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="g2" name="Instrução suficiente?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t8" name="Relatar, votar e deliberar em sessão&#10;[33% de 6 casos · espera 9 du · 6,7 h]">
      <bpmn:documentation>freq: 33% de 6; du: 9; horas: 6,7 h; status: perda; nota: Perda: diligencia externa (100%), pedido complementacao (100%)</bpmn:documentation>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t9" name="Publicar deliberação e comunicar concessionária&#10;[33% de 6 casos · espera 1 du · 0,6 h]">
      <bpmn:documentation>freq: 33% de 6; du: 1; horas: 0,6 h; status: perda; nota: Perda: diligencia externa (50%), prazo concedido (50%)</bpmn:documentation>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="f1" name="Deliberação publicada e comunicada">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="s1" targetRef="t1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1" sourceRef="t1" targetRef="j1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2" sourceRef="j1" targetRef="t2"></bpmn:sequenceFlow>

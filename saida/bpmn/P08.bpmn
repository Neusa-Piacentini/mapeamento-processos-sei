    <bpmn:sequenceFlow id="F12" sourceRef="t6" targetRef="t7"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="t7" targetRef="g2"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" name="Sim · 36%" sourceRef="g2" targetRef="t8"><bpmn:documentation>4 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15" name="Não: parecer jurídico · 45%" sourceRef="g2" targetRef="j2"><bpmn:documentation>5 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F16" name="Não: análise técnica · 18%" sourceRef="g2" targetRef="j1"><bpmn:documentation>2 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="t8" targetRef="t9"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F18" sourceRef="t9" targetRef="f1"></bpmn:sequenceFlow>

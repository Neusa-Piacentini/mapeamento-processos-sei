    <bpmn:sequenceFlow id="F6" sourceRef="t5" targetRef="g1"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" name="Sim · 50%" sourceRef="g1" targetRef="j2"><bpmn:documentation>2 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" name="Não · 50%" sourceRef="g1" targetRef="j3"><bpmn:documentation>2 transições observadas na coorte</bpmn:documentation></bpmn:sequenceFlow>

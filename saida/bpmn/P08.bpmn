    <bpmn:textAnnotation id="Nota_2"><bpmn:text>Perda: aguardando outra unidade (100%), diligencia externa (50%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="t7" targetRef="Nota_2" />
    <bpmn:textAnnotation id="Nota_3"><bpmn:text>Perda: diligencia externa (100%), pedido complementacao (100%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="t8" targetRef="Nota_3" />
    <bpmn:textAnnotation id="Nota_4"><bpmn:text>Perda: diligencia externa (50%), prazo concedido (50%)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="t9" targetRef="Nota_4" />
  </bpmn:process>
